   "source": [
    " select sku_name, sum(usage_quantity) as total_usage\n",
    "from system.billing.usage\n",
    "where month(usage_start_time) = 9 and year(usage_start_time) = 2026\n",
    "group by sku_name\n",
    "order by total_usage desc\n",
    "\n"
