            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "ec80d2ab",
      "displayName": "Job Usage",
      "queryLines": [
        "WITH serverless_cost AS (\r\n",
        "    SELECT\r\n",
        "        usage_metadata.job_id AS job_id,\r\n",
        "        workspace_id,\r\n",
        "        identity_metadata.run_as AS user,\r\n",
        "        sku_name,\r\n",
        "        count(DISTINCT usage_metadata.job_run_id) AS execution_count,\r\n",
        "        sum(usage_quantity) AS total_usage\r\n",
        "    FROM system.billing.usage\r\n",
        "    WHERE usage_date >= current_date() - INTERVAL 7 DAYS\r\n",
        "      AND usage_date <  current_date() - INTERVAL 1 DAY\r\n",
        "      AND usage_metadata.job_id IS NOT NULL\r\n",
        "      AND sku_name = 'PREMIUM_JOBS_SERVERLESS_COMPUTE_US_EAST_2'\r\n",
        "    GROUP BY usage_metadata.job_id, workspace_id, identity_metadata.run_as, sku_name\r\n",
        "\r\n",
        "),\r\n",
        "serverless_job_usage AS (\r\n",
        "    SELECT\r\n",
        "        n.job_id,\r\n",
        "        n.workspace_id,\r\n",
        "        n.user,\r\n",
        "        n.sku_name,\r\n",
        "        n.execution_count,\r\n",
        "        (n.total_usage / NULLIF(t.total_usage, 0)) * t.total_cost AS total_cost\r\n",
        "    FROM serverless_cost n\r\n",
        "    JOIN prd.value_stream_monitoring.sku_usage_cost t\r\n",
        "      ON t.sku = n.sku_name\r\n",
        "),\r\n",
        "\r\n",
        "managed_cost AS (\r\n",
        "    SELECT\r\n",
        "        usage_metadata.job_id AS job_id,\r\n",
        "        usage_metadata.cluster_id AS cluster_id,\r\n",
        "        workspace_id,\r\n",
        "        identity_metadata.run_as AS user,\r\n",
        "        sku_name,\r\n",
        "        usage_metadata.node_type AS node_type,\r\n",
        "        count(DISTINCT usage_metadata.job_run_id) AS execution_count,\r\n",
        "        sum(usage_quantity) AS total_usage\r\n",
        "    FROM system.billing.usage\r\n",
        "    WHERE usage_date >= current_date() - INTERVAL 7 DAYS\r\n",
        "      AND usage_date <  current_date() - INTERVAL 1 DAY\r\n",
        "      AND usage_metadata.job_id IS NOT NULL\r\n",
        "      AND sku_name = 'PREMIUM_JOBS_COMPUTE'\r\n",
        "    GROUP BY usage_metadata.job_id, usage_metadata.cluster_id, workspace_id,\r\n",
        "             identity_metadata.run_as, sku_name, usage_metadata.node_type\r\n",
        "),\r\n",
        "managed_job_usage AS (\r\n",
        "    SELECT\r\n",
        "        n.job_id,\r\n",
        "        n.workspace_id,\r\n",
        "        n.user,\r\n",
        "        n.sku_name,\r\n",
        "        n.execution_count,\r\n",
        "        ((n.total_usage / NULLIF(lic.total_usage, 0)) * lic.total_cost)\r\n",
        "      + ((n.total_usage / NULLIF(infra.total_usage, 0)) * infra.total_cost)\r\n",
        "        AS total_cost\r\n",
        "    FROM managed_cost n\r\n",
        "    JOIN prd.value_stream_monitoring.sku_usage_cost lic\r\n",
        "      ON lic.sku = n.sku_name\r\n",
        "    JOIN prd.value_stream_monitoring.meter_node_mapping m\r\n",
        "      ON n.node_type = m.node_type\r\n",
        "    JOIN prd.value_stream_monitoring.sku_usage_cost infra\r\n",
        "      ON infra.sku = m.Meter\r\n",
        "),\r\n",
        "\r\n",
        "combined AS (\r\n",
        "    SELECT job_id, workspace_id, user, sku_name, execution_count, total_cost FROM serverless_job_usage\r\n",
        "    UNION ALL\r\n",
        "    SELECT job_id, workspace_id, user, sku_name, execution_count, total_cost FROM managed_job_usage\r\n",
        ")\r\n",
        "\r\n",
        "SELECT\r\n",
        "    job_id,\r\n",
        "    sum(execution_count) AS execution_count,\r\n",
        "    user,\r\n",
        "    max(sku_name) AS sku_name,\r\n",
        "    sum(total_cost) AS total_cost\r\n",
        "FROM combined\r\n",
        "GROUP BY job_id, workspace_id, user\r\n",
        "ORDER BY total_cost DESC\r\n",
        "LIMIT 10"
      ],
      "catalog": "prd",
      "schema": "value_stream_monitoring"
    },
    {
      "name": "ddbc3027",
      "displayName": "Databricks Cost Fact",
      "queryLines": [
        "with license_cost as( \r\n",
        "    select Date, Meter, sum(Cost), 'License' as pricing_type from value_stream_monitoring.databricks_costs_daily\r\n",
        "where Date >= current_date() - interval 7 days\r\n",
        "and Date <= current_date() - interval 1 day\r\n",
        "group by Date, Meter, pricing_type),\r\n",
        "\r\n",
        "infra_cost as(\r\n",
        "    select Date, Meter, sum(Cost), 'Infra' as pricing_type from value_stream_monitoring.databricks_infra_costs_daily\r\n",
        "where Date >= current_date() - interval 7 days\r\n",
        "and Date <= current_date() - interval 1 day\r\n",
        "group by Date, Meter, pricing_type\r\n",
        ")\r\n",
        "\r\n",
        "select * from license_cost \r\n",
        "union all \r\n",
        "select * from infra_cost\r\n"
      ]
    },
    {
      "name": "346f69a8",
      "displayName": "SKU Cost Fact",
      "queryLines": [
        "SELECT \r\n",
        "  CASE WHEN sku LIKE '%PREMIUM%' THEN sku ELSE 'INFRA' END AS sku, \r\n",
        "  sum(total_cost) as total_cost, \r\n",
        "  sum(total_cost)/sum(total_usage) as cost_per_dbu\r\n",
        "FROM value_stream_monitoring.sku_usage_cost\r\n",
        "group by CASE WHEN sku LIKE '%PREMIUM%' THEN sku ELSE 'INFRA' END\r\n",
        "order by total_cost desc\r\n"
      ]
    },
    {
      "name": "ee234277",
      "displayName": "Warehouse Usage",
      "queryLines": [
        "with warehouse_usage as (select \r\n",
        "  usage_metadata.warehouse_id as warehouse_id,\r\n",
        "  sku_name, \r\n",
        "  sum(usage_quantity) as total_usage, \r\n",
        "  identity_metadata.owned_by as user\r\n",
        "from system.billing.usage\r\n",
        "where usage_date >= current_date() - interval 7 days\r\n",
        "and usage_date <= current_date() - interval 1 day\r\n",
        "and usage_metadata.warehouse_id is not null\r\n",
        "group by usage_metadata.warehouse_id,identity_metadata.owned_by ,sku_name, user\r\n",
        "order by total_usage desc\r\n",
        ") \r\n",
        "SELECT\r\n",
        "  n.warehouse_id,\r\n",
        "  n.sku_name,\r\n",
        "  n.user,\r\n",
        "  (n.total_usage / t.total_usage) * t.total_cost AS warehouse_run_cost\r\n",
        "FROM\r\n",
        "  warehouse_usage n CROSS JOIN prd.value_stream_monitoring.sku_usage_cost t\r\n",
        "WHERE\r\n",
        "  n.sku_name = t.sku\r\n",
        "ORDER BY\r\n",
        "  warehouse_run_cost DESC\r\n",
        "limit 10"
      ]
    },
    {
      "name": "a28c907b",
      "displayName": "Query Usage",
      "queryLines": [
        "with total_warehouse_id as (\r\n",
        "  select\r\n",
        "    compute.warehouse_id as warehouse_id,\r\n",
        "    sum(total_duration_ms) as total_query_time,\r\n",
        "    count(distinct statement_id) as number_of_queries\r\n",
        "  from system.query.history\r\n",
        "  where start_time >= current_date() - interval 7 days\r\n",
        "  and start_time<= current_date() - interval 1 days\r\n",
        "  group by compute.warehouse_id\r\n",
        "),\r\n",
        "total_query_usage as (\r\n",
        "  select\r\n",
        "    statement_text,\r\n",
        "    executed_by as user_name,\r\n",
        "    compute.warehouse_id as warehouse_id,\r\n",
        "    sum(total_duration_ms) as total_query_time,\r\n",
        "    count(distinct start_time) as query_count\r\n",
        "  from system.query.history\r\n",
        "  where start_time >= current_date() - interval 7 days\r\n",
        "  and start_time<= current_date() - interval 1 days\r\n",
        "  group by statement_text, executed_by, compute.warehouse_id\r\n",
        "),\r\n",
        "\r\n",
        "total_warehouse_usage as (\r\n",
        "  select\r\n",
        "    usage_metadata.warehouse_id as warehouse_id,\r\n",
        "    sku_name,\r\n",
        "    sum(usage_quantity) as total_usage\r\n",
        "  from system.billing.usage\r\n",
        "  where usage_date >= current_date() - interval 7 days\r\n",
        "  and usage_date<= current_date() - interval 1 days\r\n",
        "    and usage_metadata.warehouse_id is not null\r\n",
        "    and sku_name = 'PREMIUM_SERVERLESS_SQL_COMPUTE_US_EAST_2'\r\n",
        "  group by usage_metadata.warehouse_id, sku_name\r\n",
        "),\r\n",
        "\r\n",
        "warehouse_cost as (\r\n",
        "  select\r\n",
        "    n.warehouse_id,\r\n",
        "    (n.total_usage / c.total_usage) * c.total_cost as warehouse_run_cost\r\n",
        "  from total_warehouse_usage n\r\n",
        "  join prd.value_stream_monitoring.sku_usage_cost c\r\n",
        "    on n.sku_name = c.sku\r\n",
        ")\r\n",
        "\r\n",
        "select\r\n",
        "  q.statement_text,\r\n",
        "  q.user_name,\r\n",
        "  q.warehouse_id,\r\n",
        "  sum(q.query_count) as query_count,\r\n",
        "  sum((q.total_query_time / t.total_query_time) * w.warehouse_run_cost) as query_cost\r\n",
        "from total_query_usage q\r\n",
        "join total_warehouse_id t\r\n",
        "  on q.warehouse_id = t.warehouse_id\r\n",
        "join warehouse_cost w\r\n",
        "  on q.warehouse_id = w.warehouse_id\r\n",
        "group by q.statement_text, q.user_name, q.warehouse_id\r\n",
        "order by query_cost desc\r\n",
        "limit 10\r\n"
      ]
    },
    {
      "name": "8b415133",
      "displayName": "User Usage",
      "queryLines": [
        "select usage_date , count(distinct identity_metadata.run_as) as total_users\r\n",
        "from system.billing.usage\r\n",
        "where usage_date >= current_date() - interval 7 days\r\n",
        "and usage_date <= current_date() - interval 1 days\r\n",
        "group by  usage_date\r\n",
        "order by usage_date"
      ]
    },
