{
  "datasets": [
    {
      "name": "9e31b703",
      "displayName": "Notebook Usage",
      "queryLines": [
        "WITH notebook_usage AS (\r\n",
        "  SELECT\r\n",
        "    usage_metadata.notebook_id AS notebook_id,\r\n",
        "    usage_metadata.notebook_path AS notebook_path,\r\n",
        "    SUM(usage_quantity) AS total_usage,\r\n",
        "    identity_metadata.run_as AS user\r\n",
        "  FROM\r\n",
        "    system.billing.usage\r\n",
        "  WHERE\r\n",
        "    sku_name IN ('PREMIUM_ALL_PURPOSE_SERVERLESS_COMPUTE_US_EAST_2')\r\n",
        "    AND usage_metadata.job_id IS NULL\r\n",
        "    AND usage_metadata.notebook_id IS NOT NULL\r\n",
        "    and usage_date >= current_date() - interval 7 days\r\n",
        "    and usage_date <= current_date() - interval 1 day\r\n",
        "  GROUP BY\r\n",
        "    usage_metadata.notebook_id,\r\n",
        "    usage_metadata.notebook_path,\r\n",
        "    identity_metadata.run_as\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  n.notebook_id,\r\n",
        "  n.notebook_path,\r\n",
        "  n.user,\r\n",
        "  (n.total_usage / t.total_usage) * t.total_cost AS notebook_cost\r\n",
        "FROM\r\n",
        "  notebook_usage n CROSS JOIN prd.value_stream_monitoring.sku_usage_cost t\r\n",
        "WHERE\r\n",
        "  t.sku = 'PREMIUM_ALL_PURPOSE_SERVERLESS_COMPUTE_US_EAST_2'\r\n",
        "ORDER BY\r\n",
        "  notebook_cost DESC\r\n",
        "limit 10"
      ],
      "catalog": "prd",
      "schema": "value_stream_monitoring"
    },
    {
      "name": "33dd8f9f",
      "displayName": "sku_meter_mapping",
      "config": {
        "version": "1.1",
        "source": "prd.value_stream_monitoring.sku_meter_mapping",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
